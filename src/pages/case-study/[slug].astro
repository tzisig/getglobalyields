---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import Sidebar from '../../components/Sidebar.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import InlineNewsletterAfterThirdParagraph from '../../components/InlineNewsletterAfterThirdParagraph.astro';
import AffiliateDisclaimer from '../../components/AffiliateDisclaimer.astro';
import FinancialDisclaimer from '../../components/FinancialDisclaimer.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ThemeHeroImage from '../../components/ThemeHeroImage.astro';
import PortfolioRecoveryChart from '../../components/PortfolioRecoveryChart.astro';

// Chart switch for the recovery case study. true = PortfolioRecoveryChart component,
// false = the previous inline lightweight-charts implementation (kept intact below).
const USE_PORTFOLIO_RECOVERY_CHART = false;

export async function getStaticPaths() {
  const posts = await getCollection('case-study').catch(() => []);
  return posts.filter(post => import.meta.env.DEV || !post.data.draft).map(post => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
if (!post) return Astro.redirect('/404');
const { Content, headings } = await render(post);
const heroImageLight = post.data.heroImageLight ?? post.data.heroImage;
const heroImageDark = post.data.heroImageDark ?? post.data.heroImage;
const fallbackHeroImage = heroImageDark ?? heroImageLight;
const resolvedSlug = post.data.slug ?? post.id;
const isRecoveryChartPost =
  resolvedSlug === 'from-minus-70-to-plus-492k-real-tqqq-recovery-case-study' ||
  Astro.url.pathname.includes('/case-study/from-minus-70-to-plus-492k-real-tqqq-recovery-case-study') ||
  post.data.title.includes('From -72% to over +250%');

type CandlePoint = {
  time: string;
  open: number;
  high: number;
  low: number;
  close: number;
};

async function getRecoveryCandles(): Promise<CandlePoint[]> {
  try {
    const period1 = Math.floor(Date.UTC(2022, 0, 1) / 1000);
    const period2 = Math.floor(Date.now() / 1000) + 86400;
    const url = `https://query1.finance.yahoo.com/v8/finance/chart/TQQQ?interval=1d&period1=${period1}&period2=${period2}&events=history&includeAdjustedClose=true`;
    const response = await fetch(url);
    if (!response.ok) return [];
    const payload = await response.json();
    const result = payload?.chart?.result?.[0];
    const timestamps = result?.timestamp || [];
    const quote = result?.indicators?.quote?.[0] || {};
    return timestamps
      .map((ts: number, idx: number) => ({
        time: new Date(ts * 1000).toISOString().slice(0, 10),
        open: Number(quote.open?.[idx]),
        high: Number(quote.high?.[idx]),
        low: Number(quote.low?.[idx]),
        close: Number(quote.close?.[idx]),
      }))
      .filter(
        (row) =>
          row.time >= '2022-01-01' &&
          Number.isFinite(row.open) &&
          Number.isFinite(row.high) &&
          Number.isFinite(row.low) &&
          Number.isFinite(row.close)
      );
  } catch {
    return [];
  }
}

const useNewChart = isRecoveryChartPost && USE_PORTFOLIO_RECOVERY_CHART;
const useOldChart = isRecoveryChartPost && !USE_PORTFOLIO_RECOVERY_CHART;
const recoveryCandles = useOldChart ? await getRecoveryCandles() : [];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
  keywords={post.data.tags}
  seo={post.data.seo}
  pubDate={post.data.pubDate?.toISOString()}
  updatedDate={post.data.updatedDate?.toISOString()}
  author={post.data.author}
  faq={post.data.schema?.faq}
  schema={post.data.schema}
>
  <article class="py-16 lg:py-24 bg-primary-900 border-b border-primary-700">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <div class="lg:col-span-2">
          <AffiliateDisclaimer />
          <header class="mb-8 text-center">
            {post.data.categories && post.data.categories.length > 0 && (
              <span class="inline-block bg-accent-500 text-primary-900 text-xs font-bold px-3 py-1 rounded uppercase tracking-wider shadow-sm mb-4">
                {post.data.categories[0]}
              </span>
            )}
            <h1 class="text-4xl md:text-5xl font-bold text-slate-100 tracking-tight mb-4">{post.data.title}</h1>
            <a href="#article-newsletter" class="lg:hidden block bg-primary-800 border border-primary-700 rounded-lg px-4 py-3 text-slate-200 text-sm font-medium mb-4 hover:border-accent-500 transition-colors">
              Want our weekly strategies? Join 5,000+ investors here
            </a>
            <div class="flex items-center justify-center text-slate-400 text-sm space-x-4">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span>&bull;</span>
              <span>By {post.data.author}</span>
            </div>
          </header>

          {useNewChart ? (
            <div class="mb-12 shadow-2xl"><PortfolioRecoveryChart /></div>
          ) : useOldChart ? (
            <div id="recovery-chart-wrapper" class="recovery-chart-wrapper mb-12 shadow-2xl border border-primary-700 rounded-xl overflow-hidden">
              <div class="recovery-chart-header px-5 py-4 border-b border-primary-700 flex items-center justify-between gap-4">
                <div>
                  <p class="text-sm font-semibold tracking-wide">Portfolio Recovery Timeline</p>
                  <p class="text-xs text-slate-400">From 01/01/2022 to today</p>
                </div>
                <button type="button" id="recovery-chart-fs" class="recovery-chart-fs-btn" aria-label="View chart full screen" title="Full screen">
                  <svg class="fs-enter" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                  <svg class="fs-exit" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3"/></svg>
                </button>
              </div>
              <div class="recovery-chart relative">
                <div id="recovery-chart-dark" class="tv-chart theme-dark-only"></div>
                <div id="recovery-chart-light" class="tv-chart theme-light-only"></div>
                <script id="recovery-chart-data" type="application/json" set:html={JSON.stringify(recoveryCandles)} />
              </div>
            </div>
          ) : (
            fallbackHeroImage && (
              <ThemeHeroImage
                darkSrc={heroImageDark ?? fallbackHeroImage}
                lightSrc={heroImageLight ?? fallbackHeroImage}
                alt={post.data.tags?.[0] || post.data.title}
                width={post.data.heroImageWidth ?? 840}
                height={post.data.heroImageHeight ?? 560}
                class="w-full h-auto rounded-xl mb-12 shadow-2xl border border-primary-700"
              />
            )
          )}

          <div class="article-content prose prose-invert prose-lg prose-a:text-accent-500 hover:prose-a:text-accent-400 max-w-none">
            <TableOfContents headings={headings} />
            <Content />
          </div>
          <InlineNewsletterAfterThirdParagraph />

          <FinancialDisclaimer />
          <AuthorBio name={post.data.author} />
        </div>

        <div class="hidden md:block lg:col-span-1">
          <Sidebar />
        </div>
      </div>
      <div class="mt-10 lg:mt-12 lg:max-w-[calc(66.666667%-1.5rem)]">
        <NewsletterForm formId="article-newsletter" />
      </div>
    </div>
  </article>

  {useOldChart && (
    <script is:inline>
      function parseChartData() {
        const el = document.getElementById('recovery-chart-data');
        if (!el) return [];
        try {
          const parsed = JSON.parse(el.textContent || '[]');
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }

      function buildPortfolioSeries(candles) {
        const basePoint = candles.find((point) => point.time >= '2022-01-18') || candles[0];
        if (!basePoint) return [];
        const baseClose = basePoint.close;
        return candles.map((point) => ({
          time: point.time,
          value: Math.round((point.close / baseClose) * 100000),
        }));
      }

      function toBusinessDay(isoDate) {
        const [year, month, day] = isoDate.split('-').map((part) => Number(part));
        return { year, month, day };
      }

      function bubbleConfig(theme) {
        const dark = theme === 'dark';
        return {
          bubbleBg: dark ? 'rgba(10, 22, 38, 0.94)' : 'rgba(255, 255, 255, 0.96)',
          bubbleText: dark ? '#f8fafc' : '#0f172a',
          bubbleMuted: dark ? '#dbeafe' : '#334155',
          bubbleBorder: '#51d84f',
          green: '#58f25b',
          red: '#ef4444',
          line: dark ? 'rgba(43, 60, 93, 0.52)' : 'rgba(148, 163, 184, 0.35)',
          chartBg: dark ? '#071a33' : '#f8fafc',
        };
      }

      function drawBubble(ctx, px, py, opts, cw, ch) {
        const w = 104;
        const h = opts.note ? 60 : 48;
        const r = 8;
        let x = Math.min(Math.max(px + opts.dx, 4), cw - w - 4);
        let y = Math.min(Math.max(py + opts.dy, 4), ch - h - 4);
        const c = opts.colors;

        // Connector from the nearest bubble edge to the actual data point
        const bx = Math.min(Math.max(px, x), x + w);
        const by = Math.min(Math.max(py, y), y + h);
        const len = Math.hypot(px - bx, py - by);
        ctx.save();
        ctx.strokeStyle = c.bubbleBorder;
        ctx.fillStyle = c.bubbleBorder;
        ctx.lineWidth = 1.2;
        if (len > 6) {
          const ang = Math.atan2(py - by, px - bx);
          const ex = px - Math.cos(ang) * 5;
          const ey = py - Math.sin(ang) * 5;
          ctx.beginPath();
          ctx.moveTo(bx, by);
          ctx.lineTo(ex, ey);
          ctx.stroke();
          ctx.beginPath();
          ctx.moveTo(ex, ey);
          ctx.lineTo(ex - 7 * Math.cos(ang - 0.4), ey - 7 * Math.sin(ang - 0.4));
          ctx.lineTo(ex - 7 * Math.cos(ang + 0.4), ey - 7 * Math.sin(ang + 0.4));
          ctx.closePath();
          ctx.fill();
        }
        ctx.beginPath();
        ctx.arc(px, py, 3, 0, Math.PI * 2);
        ctx.fill();

        // Bubble
        ctx.fillStyle = c.bubbleBg;
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();

        ctx.textAlign = 'center';
        ctx.fillStyle = c.green;
        ctx.font = '600 11px Inter, system-ui, sans-serif';
        ctx.fillText(opts.title, x + w / 2, y + 14);
        ctx.fillStyle = c.bubbleText;
        ctx.font = '500 9px Inter, system-ui, sans-serif';
        ctx.fillText(opts.date, x + w / 2, y + 26);
        ctx.fillStyle = opts.negative ? c.red : c.green;
        ctx.font = '600 11px Inter, system-ui, sans-serif';
        ctx.fillText(opts.value, x + w / 2, y + 40);
        if (opts.note) {
          ctx.fillStyle = c.bubbleMuted;
          ctx.font = '500 8px Inter, system-ui, sans-serif';
          ctx.fillText(opts.note, x + w / 2, y + 53);
        }
        ctx.restore();
      }

      async function initRecoveryChart() {
        if (!window.LightweightCharts) {
          const existing = document.querySelector('script[data-lwc-recovery="1"]');
          if (existing) return;
          const lwcScript = document.createElement('script');
          lwcScript.src = 'https://unpkg.com/lightweight-charts/dist/lightweight-charts.standalone.production.js';
          lwcScript.async = true;
          lwcScript.dataset.lwcRecovery = '1';
          lwcScript.onload = initRecoveryChart;
          document.head.appendChild(lwcScript);
          return;
        }

        const { createChart, CandlestickSeries, LineSeries } = window.LightweightCharts;
        const darkContainer = document.getElementById('recovery-chart-dark');
        const lightContainer = document.getElementById('recovery-chart-light');
        if (!darkContainer || !lightContainer) return;
        if (darkContainer.dataset.ready === '1' || lightContainer.dataset.ready === '1') return;
        darkContainer.dataset.ready = '1';
        lightContainer.dataset.ready = '1';

        // Try live fetch first, fall back to build-time data
        let candles = [];
        try {
          const period1 = Math.floor(Date.UTC(2022, 0, 1) / 1000);
          const period2 = Math.floor(Date.now() / 1000) + 86400;
          const res = await fetch(
            `https://query1.finance.yahoo.com/v8/finance/chart/TQQQ?interval=1d&period1=${period1}&period2=${period2}&events=history&includeAdjustedClose=true`,
            { headers: { 'User-Agent': 'Mozilla/5.0' } }
          );
          if (res.ok) {
            const payload = await res.json();
            const result = payload?.chart?.result?.[0];
            const timestamps = result?.timestamp || [];
            const quote = result?.indicators?.quote?.[0] || {};
            const live = timestamps
              .map((ts, idx) => ({
                time: new Date(ts * 1000).toISOString().slice(0, 10),
                open: Number(quote.open?.[idx]),
                high: Number(quote.high?.[idx]),
                low: Number(quote.low?.[idx]),
                close: Number(quote.close?.[idx]),
              }))
              .filter(r => r.time >= '2022-01-01' && Number.isFinite(r.open) && Number.isFinite(r.close));
            if (live.length) candles = live;
          }
        } catch {}

        // Fall back to build-time data if fetch failed
        if (!candles.length) candles = parseChartData();
        if (!candles.length) return;
        const chartCandles = candles.map((point) => ({
          ...point,
          time: toBusinessDay(point.time),
        }));
        const portfolioData = buildPortfolioSeries(candles).map((point) => ({
          ...point,
          time: toBusinessDay(point.time),
        }));
        const priceByDate = new Map(candles.map((c) => [c.time, c.close]));

        const annotations = [
          { key: 'start', time: '2022-01-18', title: 'Start', date: 'Jan 2022', value: '$100,000', dx: 30, dy: -80 },
          { key: 'bottom', time: '2023-02-13', title: 'Bottom', date: 'Feb 2023', value: '-72%', note: '(~$28,000)', negative: true, dx: -52, dy: -110 },
          { key: 'temp', time: '2025-02-10', title: 'Temp Record', date: 'Feb 2025', value: '$465,000', dx: -150, dy: -90 },
          { key: 'drop', time: '2025-04-07', title: 'Dropdown', date: 'Apr 2025', value: '$340,000', dx: 30, dy: 40 },
          { key: 'today', time: '2026-04-27', title: 'Today', date: 'Apr 2026', value: '$492,000', note: '(+245% total return)', dx: -150, dy: -95 },
        ];

        function mount(container, theme) {
          const colors = bubbleConfig(theme);
          const chart = createChart(container, {
            autoSize: true,
            layout: { background: { color: colors.chartBg }, textColor: colors.bubbleText },
            rightPriceScale: { borderColor: colors.line },
            timeScale: { borderColor: colors.line, rightOffset: 2, barSpacing: 8 },
            grid: { vertLines: { color: colors.line }, horzLines: { color: colors.line } },
            localization: { locale: 'en-US' },
            crosshair: { vertLine: { visible: true }, horzLine: { visible: true } },
          });

          const series = typeof chart.addSeries === 'function'
            ? chart.addSeries(CandlestickSeries, {
                upColor: '#13c296',
                downColor: '#ef4444',
                wickUpColor: '#13c296',
                wickDownColor: '#ef4444',
                borderVisible: false,
                priceLineVisible: false,
              })
            : chart.addCandlestickSeries({
                upColor: '#13c296',
                downColor: '#ef4444',
                wickUpColor: '#13c296',
                wickDownColor: '#ef4444',
                borderVisible: false,
                priceLineVisible: false,
              });
          series.setData(chartCandles);
          chart.timeScale().fitContent();

          const valueSeries = typeof chart.addSeries === 'function'
            ? chart.addSeries(LineSeries, {
                color: 'rgba(0,0,0,0)',
                lineWidth: 1,
                priceLineVisible: false,
                lastValueVisible: false,
                priceScaleId: 'portfolio-hidden',
              })
            : chart.addLineSeries({
                color: 'rgba(0,0,0,0)',
                lineWidth: 1,
                priceLineVisible: false,
                lastValueVisible: false,
                priceScaleId: 'portfolio-hidden',
              });
          valueSeries.setData(portfolioData);
          chart.priceScale('portfolio-hidden').applyOptions({ visible: false });

          const customPane = document.createElement('canvas');
          customPane.className = 'chart-annotation-canvas';
          container.appendChild(customPane);

          function redraw() {
            const width = container.clientWidth;
            const height = container.clientHeight;
            if (!width || !height) return;
            customPane.width = width * window.devicePixelRatio;
            customPane.height = height * window.devicePixelRatio;
            customPane.style.width = `${width}px`;
            customPane.style.height = `${height}px`;
            const ctx = customPane.getContext('2d');
            if (!ctx) return;
            ctx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);
            ctx.clearRect(0, 0, width, height);

            for (const a of annotations) {
              const x = chart.timeScale().timeToCoordinate(toBusinessDay(a.time));
              const y = series.priceToCoordinate(priceByDate.get(a.time) ?? candles[candles.length - 1].close);
              if (x == null || y == null) continue;
              drawBubble(ctx, x, y, { ...a, colors }, width, height);
            }
          }

          chart.timeScale().subscribeVisibleLogicalRangeChange(redraw);
          chart.subscribeCrosshairMove(redraw);
          window.addEventListener('resize', () => { chart.timeScale().fitContent(); redraw(); });
          redraw();
          return chart;
        }

        mount(darkContainer, 'dark');
        mount(lightContainer, 'light');
      }

      function setupRecoveryFullscreen() {
        const wrapper = document.getElementById('recovery-chart-wrapper');
        const btn = document.getElementById('recovery-chart-fs');
        const area = wrapper && wrapper.querySelector('.recovery-chart');
        if (!wrapper || !btn || !area || wrapper.dataset.fsReady === '1') return;
        wrapper.dataset.fsReady = '1';
        const nativeFs = !!(wrapper.requestFullscreen || wrapper.webkitRequestFullscreen);
        const isOpen = () => !!(document.fullscreenElement || document.webkitFullscreenElement) || wrapper.classList.contains('is-pseudo-fs');
        const refresh = () => setTimeout(() => window.dispatchEvent(new Event('resize')), 60);
        function open() {
          if (nativeFs) {
            (wrapper.requestFullscreen || wrapper.webkitRequestFullscreen).call(wrapper);
          } else {
            wrapper.classList.add('is-pseudo-fs');
            document.body.style.overflow = 'hidden';
            refresh();
          }
        }
        function close() {
          if (document.fullscreenElement || document.webkitFullscreenElement) {
            (document.exitFullscreen || document.webkitExitFullscreen).call(document);
          } else {
            wrapper.classList.remove('is-pseudo-fs');
            document.body.style.overflow = '';
            refresh();
          }
        }
        btn.addEventListener('click', (e) => { e.stopPropagation(); isOpen() ? close() : open(); });
        // A plain click on the chart opens full screen; a drag (panning the chart) does not.
        let downX = 0, downY = 0;
        area.addEventListener('pointerdown', (e) => { downX = e.clientX; downY = e.clientY; });
        area.addEventListener('click', (e) => {
          if (isOpen()) return;
          if (Math.hypot(e.clientX - downX, e.clientY - downY) > 5) return;
          open();
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && wrapper.classList.contains('is-pseudo-fs')) close(); });
        document.addEventListener('fullscreenchange', refresh);
        document.addEventListener('webkitfullscreenchange', refresh);
      }

      initRecoveryChart();
      setupRecoveryFullscreen();
      document.addEventListener('astro:page-load', () => { initRecoveryChart(); setupRecoveryFullscreen(); });
    </script>
  )}

  <style>
    .recovery-chart {
      position: relative;
      width: 100%;
      height: 430px;
      background: #071a33;
      cursor: zoom-in;
    }
    .recovery-chart-fs-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 8px;
      border: 1px solid rgba(148, 163, 184, 0.35);
      color: #cbd5e1;
      background: transparent;
      cursor: pointer;
      flex-shrink: 0;
    }
    .recovery-chart-fs-btn:hover { border-color: #eab308; color: #eab308; }
    .recovery-chart-fs-btn .fs-exit { display: none; }
    .recovery-chart-wrapper:fullscreen,
    .recovery-chart-wrapper.is-pseudo-fs {
      position: fixed;
      inset: 0;
      z-index: 9999;
      margin: 0;
      width: 100vw;
      height: 100vh;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      background: #071a33;
    }
    .recovery-chart-wrapper:fullscreen .recovery-chart,
    .recovery-chart-wrapper.is-pseudo-fs .recovery-chart {
      flex: 1;
      height: auto;
      cursor: default;
    }
    .recovery-chart-wrapper:fullscreen .fs-enter,
    .recovery-chart-wrapper.is-pseudo-fs .fs-enter { display: none; }
    .recovery-chart-wrapper:fullscreen .fs-exit,
    .recovery-chart-wrapper.is-pseudo-fs .fs-exit { display: inline; }
    .tv-chart {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    :global(.chart-annotation-canvas) {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 4;
    }
    @media (max-width: 640px) {
      .recovery-chart {
        height: 360px;
      }
    }
  </style>
</BaseLayout>
