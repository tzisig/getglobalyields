---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('estate-planning').catch(() => []))
  .filter(p => !p.data.draft)
  .map(p => ({ ...p, type: 'estate-planning', url: `/estate-planning/${p.id}/` }));
---

<BaseLayout
  title="Estate Planning for International Investors"
  description="US estate tax exposure, account structures, and cross-border inheritance planning for non-US investors holding US stocks and ETFs."
  collection={{
    name: "Estate Planning for International Investors",
    items: posts.map(post => ({
      name: post.data.title,
      url: `/estate-planning/${post.id}/`
    }))
  }}
>
  <div class="bg-primary-900 py-16 lg:py-24 border-b border-primary-700 relative overflow-hidden">
    <div class="container relative mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-100 mb-6">
        <span class="text-accent-500">Estate Planning</span> for International Investors
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
        US estate tax exposure, account structures, and cross-border inheritance planning for non-US investors holding US stocks and ETFs.
      </p>
      <p class="text-base text-slate-400 leading-relaxed max-w-2xl mx-auto mt-4">
        Non-resident aliens get a $60,000 US estate tax exemption - a fraction of the amount US citizens get - which means a US brokerage account can create an unexpected estate tax bill for heirs. Start with <a href="/estate-planning/us-estate-tax-non-resident-aliens-60000-exemption/" class="text-accent-500 hover:underline">the $60,000 exemption explained</a>, then see the account structures that reduce exposure in <a href="/estate-planning/avoiding-us-estate-tax-brokerage-account/" class="text-accent-500 hover:underline">avoiding US estate tax on a brokerage account</a>.
      </p>
    </div>
  </div>

  <section class="py-16 bg-primary-800 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.length > 0 ? posts.map((post, index) => (
          <Card
            title={post.data.title}
            keyword={post.data.tags?.[0]}
            description={post.data.description}
            href={post.url}
            date={post.data.pubDate}
            categoryName={post.type}
            imageDark={post.data.heroImage}
            imageLight={post.data.heroImage?.replace('/images/blog/', '/images/blog/light/')}
            imageWidth={post.data.heroImageWidth ?? 840}
            imageHeight={post.data.heroImageHeight ?? 560}
            priority={index === 0}
          />
        )) : (
           <div class="col-span-full text-center py-12 bg-primary-900 rounded-lg border border-primary-700 border-dashed">
             <p class="text-slate-400">Content coming soon!</p>
           </div>
        )}
      </div>
    </div>
  </section>
  <div class="bg-primary-900 border-t border-primary-700 py-6 min-h-[120px]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <p class="text-xs text-slate-500 text-center leading-relaxed">
        <strong class="text-slate-400">Financial Disclaimer:</strong> This content is for educational purposes only and is not financial advice. Investing involves risk. <a href="/disclaimer/" class="hover:text-accent-500 underline">Read full disclaimer</a>.
      </p>
    </div>
  </div>
</BaseLayout>
