---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { taxTreatyCountries } from '../data/tax-treaty-countries';

const posts = (await getCollection('taxes'))
  .filter(p => !p.data.draft)
  .map(p => ({ ...p, type: 'taxes', url: `/taxes/${p.id}/` }));

// Map each post to the first letter of its country name (from the shared country data),
// so visitors can jump straight to their country instead of scrolling the whole grid.
// Reference articles that aren't about a specific country (PFIC rules, W-8BEN, etc.) get no
// letter and are only shown when no letter filter is active.
const countryNameBySlug = new Map(taxTreatyCountries.map(([, name, , , , slug]) => [slug, name]));
const postsWithLetter = posts.map(post => {
  const countryName = countryNameBySlug.get(post.id);
  return { ...post, letter: countryName ? countryName.charAt(0).toUpperCase() : null };
});
const availableLetters = [...new Set(postsWithLetter.map(p => p.letter).filter((l): l is string => l !== null))].sort();
---

<BaseLayout
  title="International Withholding Tax Guide - Global Access"
  description="Navigate global withholding tax, W-8BEN forms, dividend taxes, and tax treaties to protect your investment yields."
  collection={{
    name: "Taxes",
    items: posts.map(post => ({
      name: post.data.title,
      url: `/taxes/${post.id}/`
    }))
  }}
>
  <div class="bg-primary-900 py-16 lg:py-24 border-b border-primary-700 relative overflow-hidden">
    <div class="container relative mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-100 mb-6">
        Navigating <span class="text-accent-500">Taxes</span>
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Don't let foreign withholding taxes eat your profits. Learn how to legally optimize your tax structure globally.
      </p>
    </div>
  </div>

  <section class="py-16 bg-primary-800 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <a
        href="/resources/tax-map/"
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-primary-900 border border-primary-700 hover:border-accent-500 rounded-xl px-6 py-5 mb-10 transition-colors group"
      >
        <div class="flex items-center gap-4">
          <span class="flex-shrink-0 w-11 h-11 rounded-full bg-accent-bg flex items-center justify-center">
            <svg class="w-6 h-6 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </span>
          <div>
            <p class="text-slate-100 font-bold">Not sure which guide you need?</p>
            <p class="text-slate-400 text-sm">Find your country on the interactive US Tax Treaty World Map</p>
          </div>
        </div>
        <span class="text-accent-500 font-bold text-sm flex items-center gap-1 flex-shrink-0 group-hover:translate-x-1 transition-transform">
          Open the map
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </span>
      </a>

      {posts.length > 0 && (
        <div class="mb-6 max-w-md">
          <label for="taxes-search" class="sr-only">Search tax guides</label>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-500 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
            </svg>
            <input
              type="search"
              id="taxes-search"
              placeholder="Search by country or topic (e.g. Germany, W-8BEN, capital gains)"
              class="w-full bg-primary-900 border border-primary-700 focus:border-accent-500 rounded-lg pl-11 pr-4 py-3 text-slate-100 placeholder:text-slate-500 outline-none transition-colors"
              autocomplete="off"
            />
          </div>
          <p id="taxes-search-count" class="text-slate-500 text-xs mt-2"></p>
        </div>
      )}

      {availableLetters.length > 0 && (
        <div class="mb-10">
          <p class="text-slate-400 text-sm mb-3">Or jump straight to your country by its first letter (in English):</p>
          <div id="taxes-alphabet" class="notranslate flex flex-wrap gap-2 w-full" translate="no">
            <button
              type="button"
              class="taxes-letter-btn is-active px-3 py-1.5 rounded-md border border-accent-500 bg-accent-bg text-accent-500 text-sm font-semibold transition-colors"
              data-letter=""
            >
              All
            </button>
            {availableLetters.map(letter => (
              <button
                type="button"
                class="taxes-letter-btn px-3 py-1.5 rounded-md border border-primary-700 bg-primary-900 text-slate-300 text-sm font-semibold hover:border-accent-500 hover:text-accent-500 transition-colors"
                data-letter={letter}
              >
                {letter}
              </button>
            ))}
          </div>
        </div>
      )}

      <div id="taxes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {postsWithLetter.length > 0 ? postsWithLetter.map((post, index) => (
          <div
            class="contents"
            data-taxes-card
            data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}
            data-letter={post.letter ?? ''}
          >
            <Card
              title={post.data.title}
              keyword={post.data.tags?.[0]}
              description={post.data.description}
              href={post.url}
              date={post.data.pubDate}
              categoryName={post.type}
              imageDark={post.data.heroImage}
              imageLight={post.data.heroImage?.replace('/images/blog/', '/images/blog/light/')}
              imageWidth={post.data.heroImageWidth ?? 840}
              imageHeight={post.data.heroImageHeight ?? 560}
              priority={index === 0}
            />
          </div>
        )) : (
           <div class="col-span-full text-center py-12 bg-primary-900 rounded-lg border border-primary-700 border-dashed">
             <p class="text-slate-400">Content coming soon!</p>
           </div>
        )}
      </div>
      <p id="taxes-no-results" class="hidden text-center py-12 text-slate-400">
        No guides match "<span id="taxes-no-results-query"></span>". Try the <a href="/resources/tax-map/" class="text-accent-500 hover:underline">tax treaty map</a> instead.
      </p>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('taxes-search') as HTMLInputElement | null;
    const letterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.taxes-letter-btn'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-taxes-card]'));
    const countEl = document.getElementById('taxes-search-count');
    const noResultsEl = document.getElementById('taxes-no-results');
    const noResultsQueryEl = document.getElementById('taxes-no-results-query');

    let activeLetter = '';

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;
      for (const card of cards) {
        // Match against the card's live, currently-rendered text (not just the English
        // data-search attribute) so search still works after Google Translate rewrites the
        // visible title/description into the visitor's language - e.g. searching "ישראל"
        // finds the Israel guide once the page has been translated to Hebrew.
        const liveText = (card.textContent ?? '').toLowerCase();
        const englishFallback = card.dataset.search ?? '';
        const matchesQuery = query === '' || liveText.includes(query) || englishFallback.includes(query);
        const matchesLetter = activeLetter === '' || card.dataset.letter === activeLetter;
        const matches = matchesQuery && matchesLetter;
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      }
      if (countEl) {
        countEl.textContent = query === '' ? '' : `${visibleCount} of ${cards.length} guides`;
      }
      if (noResultsEl) {
        noResultsEl.classList.toggle('hidden', visibleCount !== 0);
      }
      if (noResultsQueryEl) {
        noResultsQueryEl.textContent = searchInput?.value.trim() ?? '';
      }
    }

    // Google Translate rewrites text nodes asynchronously and sometimes lazily (e.g. cards
    // further down the grid may translate a moment after the ones above them). Watching for
    // those text changes and re-running the filter means a query like "ישראל" picks up a
    // card as soon as it actually gets translated, instead of only matching whichever cards
    // happened to be translated already. Only childList/characterData is observed (not
    // attributes), so this never reacts to our own card.style.display toggling below.
    const grid = document.getElementById('taxes-grid');
    let retranslateTimer: ReturnType<typeof setTimeout> | undefined;
    if (grid) {
      const observer = new MutationObserver(() => {
        clearTimeout(retranslateTimer);
        retranslateTimer = setTimeout(applyFilters, 150);
      });
      observer.observe(grid, { childList: true, subtree: true, characterData: true });
    }

    const activeClasses = ['border-accent-500', 'bg-accent-bg', 'text-accent-500'];
    const inactiveClasses = ['border-primary-700', 'bg-primary-900', 'text-slate-300'];

    function setActiveButton(activeBtn: HTMLButtonElement) {
      for (const b of letterButtons) {
        const isActive = b === activeBtn;
        b.classList.toggle('is-active', isActive);
        b.classList.remove(...activeClasses, ...inactiveClasses);
        b.classList.add(...(isActive ? activeClasses : inactiveClasses));
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    for (const btn of letterButtons) {
      btn.addEventListener('click', () => {
        activeLetter = btn.dataset.letter ?? '';
        setActiveButton(btn);
        applyFilters();
      });
    }
  </script>
  <!-- Financial Disclaimer -->
  <div class="bg-primary-900 border-t border-primary-700 py-6 min-h-[120px]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <p class="text-xs text-slate-500 text-center leading-relaxed">
        <strong class="text-slate-400">Financial Disclaimer:</strong> This content is for educational purposes only and is not financial advice. Investing involves risk. <a href="/disclaimer/" class="hover:text-accent-500 underline">Read full disclaimer</a>.
      </p>
    </div>
  </div>
</BaseLayout>
