---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('retirement-pension').catch(() => []))
  .filter(p => !p.data.draft)
  .map(p => ({ ...p, type: 'retirement-pension', url: `/retirement-pension/${p.id}/` }));
---

<BaseLayout
  title="Retirement & Pension Planning for International Investors"
  description="Cross-border retirement and pension planning for non-US investors holding US stocks and ETFs - pension access, retirement income, and withdrawal strategy."
  collection={{
    name: "Retirement & Pension Planning",
    items: posts.map(post => ({
      name: post.data.title,
      url: `/retirement-pension/${post.id}/`
    }))
  }}
>
  <div class="bg-primary-900 py-16 lg:py-24 border-b border-primary-700 relative overflow-hidden">
    <div class="container relative mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-100 mb-6">
        <span class="text-accent-500">Retirement & Pension</span> Planning
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Cross-border retirement planning for international investors holding US stocks and ETFs - pension access, withdrawal strategy, and retiring across borders.
      </p>
      <p class="text-base text-slate-400 leading-relaxed max-w-2xl mx-auto mt-4">
        Retiring across a border changes the mechanics most retirement advice assumes: US-based 401(k) and IRA access can differ by country, required minimum distributions interact with foreign tax rules, and a domestic dividend-income strategy does not automatically work once you're filing taxes somewhere else. The guides below cover specific cases - from <a href="/retirement-pension/401k-ira-access-non-us-citizens/" class="text-accent-500 hover:underline">401(k) and IRA access for non-US citizens</a> to <a href="/retirement-pension/retirement-income-ladder-us-dividend-stocks/" class="text-accent-500 hover:underline">building a dividend income ladder</a> - rather than generic advice that skips the cross-border details.
      </p>
    </div>
  </div>

  <section class="py-16 bg-primary-800 min-h-screen">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.length > 0 ? posts.map((post, index) => (
          <Card
            title={post.data.title}
            keyword={post.data.tags?.[0]}
            description={post.data.description}
            href={post.url}
            date={post.data.pubDate}
            categoryName={post.type}
            imageDark={post.data.heroImage}
            imageLight={post.data.heroImage?.replace('/images/blog/', '/images/blog/light/')}
            imageWidth={post.data.heroImageWidth ?? 840}
            imageHeight={post.data.heroImageHeight ?? 560}
            priority={index === 0}
          />
        )) : (
           <div class="col-span-full text-center py-12 bg-primary-900 rounded-lg border border-primary-700 border-dashed">
             <p class="text-slate-400">Content coming soon!</p>
           </div>
        )}
      </div>
    </div>
  </section>
  <div class="bg-primary-900 border-t border-primary-700 py-6 min-h-[120px]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <p class="text-xs text-slate-500 text-center leading-relaxed">
        <strong class="text-slate-400">Financial Disclaimer:</strong> This content is for educational purposes only and is not financial advice. Investing involves risk. <a href="/disclaimer/" class="hover:text-accent-500 underline">Read full disclaimer</a>.
      </p>
    </div>
  </div>
</BaseLayout>
