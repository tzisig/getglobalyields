---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Get Global Yields",
  "description": "Contact form for questions about broker reviews, tax treaty guides, or content corrections on GetGlobalYields.com.",
  "url": "https://getglobalyields.com/contact/",
};
---

<BaseLayout
  title="Contact Us - Get Global Yields"
  description="Reach the Get Global Yields team with questions about broker reviews, tax treaty guides, a correction on an existing article, or a partnership inquiry."
>
  <div class="bg-primary-900 py-16 lg:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-100 tracking-tight mb-8">Contact Us</h1>
      <p class="text-lg text-slate-300 mb-6">
        Have a question, feedback, or a partnership inquiry? We'd love to hear from you. Fill out the form below and our team will get back to you as soon as possible.
      </p>

      <p class="text-slate-300 mb-12">
        Prefer to reach out directly? Email <a href="mailto:getglobalyields@gmail.com" class="text-accent-500 hover:text-accent-400 underline">getglobalyields@gmail.com</a> or connect on <a href="https://www.linkedin.com/in/tzion-sigron/" target="_blank" rel="noopener noreferrer" class="text-accent-500 hover:text-accent-400 underline">LinkedIn</a>.
      </p>

      <div class="bg-primary-800 rounded-2xl p-6 sm:p-10 border border-primary-700 shadow-xl">
        <form class="space-y-6" action="https://formsubmit.co/getglobalyields@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="New Contact Form Message">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="first-name" class="block text-sm font-medium text-slate-300 mb-2">First name</label>
              <input type="text" name="first-name" id="first-name" class="block w-full rounded-md bg-primary-900 border border-primary-600 text-slate-100 px-4 py-3 focus:border-accent-500 focus:ring-accent-500 transition-colors" placeholder="John" required>
            </div>
            <div>
              <label for="last-name" class="block text-sm font-medium text-slate-300 mb-2">Last name</label>
              <input type="text" name="last-name" id="last-name" class="block w-full rounded-md bg-primary-900 border border-primary-600 text-slate-100 px-4 py-3 focus:border-accent-500 focus:ring-accent-500 transition-colors" placeholder="Doe" required>
            </div>
          </div>
          
          <div>
            <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Email address</label>
            <input type="email" name="email" id="email" class="block w-full rounded-md bg-primary-900 border border-primary-600 text-slate-100 px-4 py-3 focus:border-accent-500 focus:ring-accent-500 transition-colors" placeholder="john@example.com" required>
          </div>
          
          <div>
            <label for="subject" class="block text-sm font-medium text-slate-300 mb-2">Subject</label>
            <input type="text" name="subject" id="subject" class="block w-full rounded-md bg-primary-900 border border-primary-600 text-slate-100 px-4 py-3 focus:border-accent-500 focus:ring-accent-500 transition-colors" placeholder="How can we help?" required>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-300 mb-2">Message</label>
            <textarea id="message" name="message" rows="6" class="block w-full rounded-md bg-primary-900 border border-primary-600 text-slate-100 px-4 py-3 focus:border-accent-500 focus:ring-accent-500 transition-colors" placeholder="Leave your message here..." required></textarea>
          </div>

          <div>
            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-base font-medium text-primary-900 bg-accent-500 hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500 focus:ring-offset-primary-900 transition-colors">
              Send Message
            </button>
          </div>
        </form>
      </div>

      <div class="mt-16">
        <h2 class="text-2xl font-bold text-slate-100 mb-4">What We Can Help With</h2>
        <p class="text-slate-300 mb-4">
          Most messages we receive fall into one of a few categories - use whichever fits, or just describe your situation in the message field above:
        </p>
        <ul class="list-disc list-inside text-slate-300 space-y-2 mb-6">
          <li><strong class="text-slate-100">Factual corrections</strong> - a rate, deadline, or figure in one of our guides is out of date or wrong. Tell us the article and the specific detail; we verify and update quickly.</li>
          <li><strong class="text-slate-100">Broker or country coverage requests</strong> - a broker, tax treaty, or topic you'd like us to cover that isn't on the site yet.</li>
          <li><strong class="text-slate-100">Partnership and press inquiries</strong> - for brokers, fintech products, or publications.</li>
          <li><strong class="text-slate-100">General feedback</strong> - what's useful, what's missing, what could be clearer.</li>
        </ul>
        <p class="text-slate-400 text-sm">
          We read every message personally and typically reply within a few business days. For a specific broker's own customer support (account issues, deposits, withdrawals), contact that broker directly rather than us - see our <a href="/best-brokers/" class="text-accent-500 hover:text-accent-400 underline">broker reviews</a> for each broker's own support channels.
        </p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
</BaseLayout>
