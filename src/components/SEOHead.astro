---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string[];
  pubDate?: string;
  updatedDate?: string;
  author?: string;
  faq?: { question: string; answer: string }[];
  seo?: {
    metaTitle?: string;
    metaDescription?: string;
    keywords?: string[];
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    twitterCard?: string;
  };
  schema?: {
    type?: string;
    headline?: string;
    description?: string;
    author?: string;
    datePublished?: string;
    dateModified?: string;
    image?: string;
    mainEntityOfPage?: string;
  };
  collection?: { name?: string; items: { name: string; url: string }[] };
  noindex?: boolean;
}

const {
  title = "Get Global Yields - Finance & Investment Insights",
  description = "Expert reviews, how-to guides, and comparisons for global financial products, high-yield accounts, and investment strategies.",
  image = "/og-image.jpg",
  type = "website",
  keywords = [],
  pubDate,
  updatedDate,
  author,
  faq = [],
  seo = {},
  schema = {},
  collection,
  noindex
} = Astro.props;

const finalTitle       = seo?.metaTitle       || title;
const finalDescription = seo?.metaDescription || description;
const finalImage       = seo?.ogImage         || image;
const finalOgTitle     = seo?.ogTitle         || finalTitle;
const finalOgDesc      = seo?.ogDescription   || finalDescription;
const finalKeywords    = seo?.keywords?.length ? seo.keywords : keywords;
const twitterCard      = seo?.twitterCard     || "summary_large_image";

const normalizedPathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(normalizedPathname, Astro.site || Astro.url);
const ogImageUrl   = new URL(finalImage, Astro.site || Astro.url);

const articleImageUrl = schema?.image
  ? new URL(schema.image, Astro.site || Astro.url).toString()
  : ogImageUrl.toString();

const articleSchema = type === "article" ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": schema?.headline || finalTitle,
  "description": schema?.description || finalDescription,
  "image": articleImageUrl,
  "datePublished": schema?.datePublished || pubDate,
  "dateModified": schema?.dateModified || updatedDate || pubDate,
  "author": { "@type": "Organization", "name": schema?.author || author || "Tzion Sigron" },
  "mainEntityOfPage": schema?.mainEntityOfPage || canonicalURL.toString(),
  "publisher": {
    "@type": "Organization",
    "name": "Get Global Yields",
    "url": "https://getglobalyields.com"
  }
} : null;

const faqSchema = faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

const homepageSchema = Astro.url.pathname === "/" ? {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://getglobalyields.com/#organization",
      "name": "Get Global Yields",
      "url": "https://getglobalyields.com/",
      "logo": "https://getglobalyields.com/logo.webp"
    },
    {
      "@type": "WebSite",
      "@id": "https://getglobalyields.com/#website",
      "name": "Get Global Yields",
      "url": "https://getglobalyields.com/",
      "publisher": { "@id": "https://getglobalyields.com/#organization" }
    }
  ]
} : null;

const collectionSchema = collection?.items?.length ? {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": collection.name || finalTitle,
  "description": finalDescription,
  "url": canonicalURL.toString(),
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": collection.items.length,
    "itemListElement": collection.items.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "url": new URL(item.url, Astro.site || Astro.url).toString()
    }))
  }
} : null;
---

<head>
  <meta charset="utf-8" />
  <!-- Prevent flash of English before Google Translate applies the visitor's
       language, and the layout shift (CLS) that comes from Google Translate
       reflowing text (e.g. button widths changing) after the page is already
       visible. Hides the page only if a translation is actually expected
       (saved cookie, or geo-detected country with no explicit English choice).
       Header.astro's triggerSelect() reveals the page as soon as translation
       is actually applied - the timeout below is only a worst-case safety net
       (e.g. Google Translate blocked or failing to load) so the page never
       stays hidden. Base 2500ms (not 600ms) because on a throttled/slow
       connection loading the translate script and its first translation call
       can genuinely take longer than 600ms, and revealing before that
       finishes is exactly what causes the visible CLS this is meant to
       prevent; extends further when the Network Information API (Chrome/
       Edge/Android only - unsupported browsers keep the base 2500ms)
       reports a slow connection. Placed as the very first thing in <head>
       (moved here from BaseLayout.astro, which put it after this whole
       <head> block) so the conditional preconnect hints below register
       before any other resource request competes for the connection -
       PageSpeed Insights was flagging them as "unused preconnect" because
       they were being added too late to matter. -->
  <script is:inline>
    (function() {
      var m = document.cookie.match(/googtrans=\/en\/([a-zA-Z-]+)/);
      var lang = m ? m[1] : null;
      if (!lang && document.cookie.indexOf('lang_choice_made=1') === -1) {
        var g = document.cookie.match(/geo_country=([A-Z]{2})/);
        if (g) {
          var COUNTRY_LANG = { IL:'iw', ES:'es', MX:'es', AR:'es', CO:'es', CL:'es', PE:'es', VE:'es', EC:'es', GT:'es', UY:'es', PY:'es', BO:'es', DO:'es', HN:'es', SV:'es', NI:'es', CR:'es', PA:'es', FR:'fr', BE:'fr', DE:'de', AT:'de', BR:'pt', PT:'pt', IT:'it', NL:'nl', PL:'pl', RU:'ru', SA:'ar', AE:'ar', EG:'ar', QA:'ar', KW:'ar', JO:'ar', OM:'ar', BH:'ar', MA:'ar', DZ:'ar', TN:'ar', IQ:'ar', LB:'ar', CN:'zh-CN', JP:'ja', KR:'ko', TR:'tr', ID:'id', TH:'th', VN:'vi' };
          lang = COUNTRY_LANG[g[1]] || null;
        }
      }
      if (lang) {
        ['https://translate.googleapis.com', 'https://translate.google.com', 'https://translate-pa.googleapis.com'].forEach(function (origin) {
          var link = document.createElement('link');
          link.rel = 'preconnect';
          link.href = origin;
          link.crossOrigin = 'anonymous';
          document.head.appendChild(link);
        });
        document.documentElement.style.setProperty('visibility', 'hidden', 'important');
        var revealDelay = 2500;
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (conn && (conn.effectiveType === 'slow-2g' || conn.effectiveType === '2g' || conn.effectiveType === '3g')) {
          revealDelay = 5000;
        }
        window.__ggyRevealTimeout = setTimeout(function() {
          document.documentElement.style.removeProperty('visibility');
        }, revealDelay);
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon.webp?v=3" />
  <meta name="generator" content={Astro.generator} />

  <link rel="canonical" href={canonicalURL} />

  {noindex && <meta name="robots" content="noindex, follow" />}

  <title>{finalTitle}</title>
  <meta name="title" content={finalTitle} />
  <meta name="description" content={finalDescription} />
  {finalKeywords.length > 0 && (
    <meta name="keywords" content={finalKeywords.join(", ")} />
  )}

  <meta property="og:type" content={type} />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={finalOgTitle} />
  <meta property="og:description" content={finalOgDesc} />
  <meta property="og:image" content={ogImageUrl} />

  <meta property="twitter:card" content={twitterCard} />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={finalOgTitle} />
  <meta property="twitter:description" content={finalOgDesc} />
  <meta property="twitter:image" content={ogImageUrl} />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Get Global Yields - RSS" href="/rss.xml" />

  <meta name='impact-site-verification' value='583bc75e-04c9-4042-a2dc-cdfce51ea9c6'>
  <meta name='impact-site-verification' value='11671c53-055e-4f0b-a0d1-8d3b07033f6d'>

  {articleSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )}
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  {homepageSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  )}
  {collectionSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  )}
  <meta name="p:domain_verify" content="55e6f8ad1a23e33deb0edc8cc395f68a"/>
</head>
