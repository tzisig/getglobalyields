---
import { BROKER_LINKS } from '../data/brokerLinks';

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

const hideCTAPaths = [
  '/best-brokers',
  '/about',
  '/contact',
  '/privacy-policy',
  '/terms',
  '/disclaimer',
];
const hideCTA = hideCTAPaths.some(path => currentPath.startsWith(path));
---

<footer class="mt-auto bg-primary-600">

  <div class="border-t border-primary-700 py-12">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 mb-10">
        <!-- Brand -->
        <div class="sm:col-span-2 lg:col-span-1">
          <a href="/" class="block mb-4">
            <img src="/logo.webp" alt="Get Global Yields" width="118" height="40" class="h-12 w-auto" style="aspect-ratio:118/40" />
          </a>
          <p class="text-sm text-slate-200 max-w-xs">
            Empowering your financial journey with expert insights, comparative reviews, and strategic investment guides.
          </p>
          <div class="mt-4 flex flex-col gap-2">
            <a href="mailto:getglobalyields@gmail.com" class="text-sm text-slate-200 hover:text-accent-500 inline-flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              getglobalyields@gmail.com
            </a>
            <a href="https://www.linkedin.com/in/tzion-sigron/" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-200 hover:text-accent-500 inline-flex items-center gap-2">
              <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              Connect on LinkedIn
            </a>
          </div>
        </div>

        <!-- Categories -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Categories</h3>
          <ul class="space-y-2">
            <li><a href="/best-brokers/" class="text-sm text-slate-200 hover:text-accent-500">Best Brokers</a></li>
            <li><a href="/start-here/" class="text-sm text-slate-200 hover:text-accent-500">Start Here</a></li>
            <li><a href="/us-investing/" class="text-sm text-slate-200 hover:text-accent-500">US Investing</a></li>
            <li><a href="/options-income/" class="text-sm text-slate-200 hover:text-accent-500">Options Income</a></li>
            <li><a href="/taxes/" class="text-sm text-slate-200 hover:text-accent-500">Taxes</a></li>
            <li><a href="/strategies/" class="text-sm text-slate-200 hover:text-accent-500">Strategies</a></li>
            <li><a href="/retirement-pension/" class="text-sm text-slate-200 hover:text-accent-500">Retirement & Pension</a></li>
            <li><a href="/estate-planning/" class="text-sm text-slate-200 hover:text-accent-500">Estate Planning</a></li>
            <li><a href="/index-funds/" class="text-sm text-slate-200 hover:text-accent-500">Index Funds & ETFs</a></li>
            <li><a href="/currency-banking/" class="text-sm text-slate-200 hover:text-accent-500">Currency & Banking</a></li>
            <li><a href="/case-study/from-minus-70-to-plus-492k-real-tqqq-recovery-case-study/" class="text-sm text-slate-200 hover:text-accent-500">Case Study</a></li>
          </ul>
        </div>

        <!-- Resources -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4"><a href="/resources/" class="text-sm text-slate-200 hover:text-accent-500">Resources</a></h3>
          <ul class="space-y-2">
            <li><a href="/resources/calculators/" class="text-sm text-slate-200 hover:text-accent-500">Calculators</a></li>
            <li><a href="/resources/glossary/" class="text-sm text-slate-200 hover:text-accent-500">Glossary</a></li>
            <li><a href="/resources/useful-links/" class="text-sm text-slate-200 hover:text-accent-500">Useful Links</a></li>
            <li><a href="/resources/broker-finder/" class="text-sm text-slate-200 hover:text-accent-500">broker-finder</a></li>
            <li><a href="/resources/broker-calculator/" class="text-sm text-slate-200 hover:text-accent-500">broker-calculator</a></li>
            <li><a href="/resources/tax-map/" class="text-sm text-slate-200 hover:text-accent-500">tax-map</a></li>
            <li><a href="/resources/investor-profiles/" class="text-sm text-slate-200 hover:text-accent-500">investor-profiles</a></li>
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Legal</h3>
          <ul class="space-y-2">
            <li><a href="/about/" class="text-sm text-slate-200 hover:text-accent-500">About Us</a></li>
            <li><a href="/contact/" class="text-sm text-slate-200 hover:text-accent-500">Contact</a></li>
            <li><a href="/privacy-policy/" class="text-sm text-slate-200 hover:text-accent-500">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-sm text-slate-200 hover:text-accent-500">Terms of Service</a></li>
            <li><a href="/disclaimer/" class="text-sm text-slate-200 hover:text-accent-500">Disclaimer</a></li>
          </ul>
        </div>

        <!-- Stay Updated -->
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4">Stay Updated</h3>
            <ul class="space-y-2">
  <li>
    <a href="/rss.xml" class="inline-flex items-center gap-2 text-sm text-slate-200 hover:text-accent-500">
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM6.75 9.25a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5zm0 3a.75.75 0 000 1.5h6.5a.75.75 0 000-1.5h-6.5zm0-6a.75.75 0 000 1.5h6.5a.75.75 0 000-1.5h-6.5z" clip-rule="evenodd" />
      </svg>
      RSS Feed
    </a>
  </li>

  <li>
    <a href="/weekly-update/" class="text-sm text-slate-200 hover:text-accent-500">
      Weekly Update
    </a>
  </li>
</ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Final CTA Section - אחרי הקטגוריות, לפני ה-Disclosure, רוחב מלא -->
  {!hideCTA && (
    <div class="w-full bg-primary-700 py-20 lg:py-24 border-t border-primary-600 shadow-inner">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-100 mb-4">Ready to Start Investing Globally?</h2>
        <p class="text-xl font-semibold text-accent-500 mb-3">Most investors choose the wrong broker and pay for it for years.</p>
        <p class="text-lg text-slate-300 mb-10 max-w-2xl mx-auto">Choosing the right broker is the most important decision you'll make as an international investor.</p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a href="/best-brokers/" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 border border-transparent text-lg font-bold rounded-md text-primary-900 bg-accent-500 hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent-500 focus:ring-offset-primary-900 shadow-lg shadow-accent-500/30 transition-all duration-200 hover:-translate-y-1">
            Compare Best Brokers
          </a>
          <a href={BROKER_LINKS.ibkr} target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 border-2 border-primary-600 text-lg font-bold rounded-md text-slate-100 bg-transparent hover:bg-primary-800 hover:border-primary-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all duration-200">
            Open IBKR Account
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Disclosure -->
  <div class="border-t border-primary-700 py-8">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm md:text-base text-slate-300 font-medium mb-6 text-center md:text-left">Used by international investors worldwide to access US markets efficiently.</p>
      <div class="text-xs text-slate-300 max-w-4xl">
        <p class="mb-2"><strong>Financial Disclaimer:</strong> The information on Get Global Yields is for educational purposes only and does not constitute financial, investment, tax, or legal advice. Brokerage fees, features, and availability are subject to change - always verify directly with the broker. International investors should consult a qualified financial advisor and tax professional before making any decisions. getglobalyields.com is not a registered investment advisor and does not provide personalized recommendations.</p>
        <p><strong>Affiliate Disclosure:</strong> Some of the links on this website are affiliate links. If you happen to click and make a purchase or open an account, we may earn a small commission at no extra cost to you. This helps support our site.</p>
      </div>

      <div class="mt-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-slate-300 text-center md:text-left">
          &copy; {currentYear} Get Global Yields. All rights reserved.
        </p>
        <a href="/best-brokers/" class="text-xs sm:text-sm text-slate-200 hover:text-accent-500 underline underline-offset-4 decoration-primary-600 hover:decoration-accent-500 transition-colors text-center md:text-right font-medium">
          Still not sure? Compare the best brokers in 2 minutes.
        </a>
      </div>
    </div>
  </div>

</footer>
