---
export interface Props {
  name?: string;
}

const { name = 'Tzion' } = Astro.props;
---

<div class="mt-16 bg-primary-600 rounded-2xl p-6 sm:p-8 border border-primary-700 shadow-xl flex flex-col sm:flex-row items-center sm:items-start gap-6 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-accent-500/5 to-transparent pointer-events-none"></div>
  <div class="shrink-0 relative z-10">
    <div class="w-24 h-24 rounded-full bg-primary-900 border-2 border-accent-500 overflow-hidden flex items-center justify-center text-accent-500 shadow-lg shadow-accent-500/20">
      <!-- Using DiceBear API for a reliable, professional placeholder avatar -->
      <img 
        src="/theauthor.webp" 
        alt={name} 
        class="w-full h-full object-cover" 
      />
    </div>
  </div>
  <div class="text-center sm:text-left relative z-10 flex-1">
    <h3 class="text-xl font-bold text-slate-100 mb-2">Written by {name}</h3>
    <p class="text-slate-300 text-sm leading-relaxed">
      Tzion Sigron is the founder and editor of GetGlobalYields. He holds a B.A. in Economics and Management and spent five years processing and integrating Tel Aviv Stock Exchange fixed-income data for financial software systems. As an active investor in both US and Israeli markets for over 4.5 years, he specializes in tax treaties, options strategies, and helping non-US investors navigate US markets with data-driven precision.
    </p>
    <p class="text-sm mt-3">
      <a href="/about/" class="text-accent-500 hover:text-accent-400 underline">Read Full Bio →</a>
      <span class="text-slate-500"> | </span>
      <a href="https://www.linkedin.com/in/tzion-sigron/" target="_blank" rel="noopener noreferrer" class="text-accent-500 hover:text-accent-400 underline">Connect on LinkedIn</a>
    </p>
  </div>
</div>
